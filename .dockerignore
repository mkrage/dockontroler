# Keep the build context to source only — everything else just slows the build
# down or busts the cache.
.git
.gitignore
.github
README.md
# LICENSE is deliberately not excluded: the Dockerfile copies it into the
# runtime image under /licenses/, which is what makes the distributed binary's
# licence terms available to whoever ends up with the image.
assets
docker-compose.example.yml
docker-compose.override.yml
.env
dist
dockontroler
dockontroler.exe
*.test
*.out
.vscode
.idea
